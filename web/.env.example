# Public browsing needs no external services. Enable after Google/Supabase console configuration.
ENABLE_GOOGLE_AUTH=false
# Copy to .env.local only when ready to configure Google login.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://localhost:3100
# Sample catalog stays explicitly DEMO until real data integration is implemented.

# Local development only; production always denies COPD data access.
COPD_INTERNAL_PREVIEW=false
COPD_API_TOKEN=
